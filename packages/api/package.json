{
  "name": "@knowledge-base-central/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "lint": "eslint --ext .ts src --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/csrf-protection": "^6.4.0",
    "@fastify/multipart": "8.3.1",
    "@fastify/passport": "^2.5.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/session": "^10.9.0",
    "@identity-service/contracts": "workspace:*",
    "@isomorphic-git/lightning-fs": "^4.6.0",
    "@knowledge-base-central/shared": "workspace:*",
    "@pact-foundation/pact": "^12.2.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.1.0",
    "connect-redis": "^9.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.26.0",
    "fastify-type-provider-zod": "2.1.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.11.1",
    "isomorphic-git": "^1.25.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.0",
    "uuid": "^14.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^1.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
