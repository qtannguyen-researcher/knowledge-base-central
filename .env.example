# ============================================================
# Knowledge Base Central — Environment Variables
# ============================================================
# Copy this file to .env and fill in values for local development.
# NEVER commit .env to version control.
#
#   cp .env.example .env
# ============================================================

# ------------------------------------
# Application
# ------------------------------------
NODE_ENV=development
PORT=3002

# ------------------------------------
# Database (PostgreSQL)
# ------------------------------------
DATABASE_URL=postgresql://kbc:kbc_dev_password@localhost:5432/knowledge_base_central

# ------------------------------------
# Identity Service
# ------------------------------------
# RSA public key for JWT verification (from identity-service)
IDENTITY_PUBLIC_KEY=your_identity_service_public_key_here

# ------------------------------------
# Redis
# ------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------
# Git Repository Storage
# ------------------------------------
GIT_REPO_PATH=/var/data/kbc/repos

# ------------------------------------
# Object Storage (S3-compatible)
# ------------------------------------
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=knowledge-base-central
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
