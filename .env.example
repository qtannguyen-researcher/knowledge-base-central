# ============================================================
# Knowledge Base Central — Environment Variables
# ============================================================
# Copy this file to .env and fill in values for local development.
# NEVER commit .env to version control.
#
#   cp .env.example .env
# ============================================================

# ------------------------------------
# Application
# ------------------------------------
NODE_ENV=development
PORT=3001

# ------------------------------------
# Database (PostgreSQL)
# ------------------------------------
# Full connection URL used by the API and migration tooling.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://kbc:kbc_dev_password@localhost:5432/knowledge_base_central

# Password for the seeded Owner account (prisma db seed)
SEED_OWNER_PASSWORD=owner_dev_password

# ------------------------------------
# Cache (Redis)
# ------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------
# Session
# ------------------------------------
# Long random string used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# ------------------------------------
# OAuth — GitHub
# ------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------
# OAuth — Google
# ------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------
# Git Repository Storage
# ------------------------------------
# Absolute path on the host where bare git repos are stored.
GIT_REPO_PATH=/var/data/kbc/repos

# ------------------------------------
# Object Storage (S3-compatible)
# ------------------------------------
# Use LocalStack, MinIO, or a real S3 bucket.
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=knowledge-base-central
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
